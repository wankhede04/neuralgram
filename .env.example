# Copy this file to .env and fill in your own values.
# Shape must stay valid JSON: {"<api-key>": "<tenant-id>"} / {"<api-key>": "<role>"}
# Roles: reader | writer | admin (see src/neuralgram/api/deps.py)
API_KEYS={"my-test-key": "demo-tenant"}
API_KEY_ROLES={"my-test-key": "admin"}

# Dev/CI default: deterministic mock model + feature-hashed embeddings, no
# provider keys needed.
MOCK_PROVIDERS=true

# Only needed when MOCK_PROVIDERS=false.
ANTHROPIC_API_KEY=

# Preferred embedding provider. If set, hint:embed routes to Jina AI's
# native /embeddings API (dimensions truncated to EMBEDDING_DIM via Jina's
# own `dimensions` param -- no schema migration needed).
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# Fallback embedding provider, only used if JINA_API_KEY is unset. Anthropic
# has no embeddings API; if this is set, hint:embed routes to OpenRouter's
# OpenAI-compatible /embeddings endpoint. If neither is set, hint:embed
# falls back to the mock BoW embedder.
# Model MUST output 384 dims (matches storage.models.EMBEDDING_DIM, a
# fixed-width pgvector column) -- sentence-transformers/all-minilm-l6-v2
# is verified to output exactly 384; the OpenRouter :free embedding models
# output 2048 and will NOT fit without a schema migration.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2

# Frontend origins allowed to call this API cross-origin (JSON list).
# Defaults to the local Vite dev server only -- add your deployed frontend
# URL(s) here, e.g. '["https://your-app.vercel.app", "http://localhost:5173"]'.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
